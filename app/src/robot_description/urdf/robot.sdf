<?xml version="1.0"?>
<sdf version="1.6">
	<model name="diff_drive_robot">
		<pose>0 0 0.05 0 0 0</pose>

		<!-- ═══ lower plate ═══ -->
		<link name="lower_plate"><pose>0 0 0.071 0 0 0</pose>
			<inertial><mass>1.5</mass><inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01</iyy><iyz>0</iyz><izz>0.02</izz></inertia></inertial>
			<collision name="collision"><geometry><box><size>0.305 0.23 0.005</size></box></geometry></collision>
			<visual name="visual"><geometry><box><size>0.305 0.23 0.005</size></box></geometry><material><ambient>0.25 0.25 0.25 1</ambient></material></visual>
		</link>

		<!-- ═══ upper plate ═══ -->
		<link name="upper_plate"><pose>0 0 0.178 0 0 0</pose>
			<inertial><mass>0.5</mass><inertia><ixx>0.005</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.005</iyy><iyz>0</iyz><izz>0.01</izz></inertia></inertial>
			<collision name="collision"><geometry><box><size>0.305 0.23 0.005</size></box></geometry></collision>
			<visual name="visual"><geometry><box><size>0.305 0.23 0.005</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
		</link>
		<joint name="upper_plate_joint" type="fixed"><parent>lower_plate</parent><child>upper_plate</child></joint>

		<!-- ═══ 4 chassis pillars ═══ -->
		<link name="pillar_fl"><pose>0.13 0.095 0.1245 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial><visual name="visual"><geometry><cylinder><radius>0.008</radius><length>0.107</length></cylinder></geometry><material><ambient>0.12 0.12 0.12 1</ambient></material></visual></link>
		<joint name="pillar_fl_joint" type="fixed"><parent>lower_plate</parent><child>pillar_fl</child></joint>
		<link name="pillar_fr"><pose>0.13 -0.095 0.1245 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial><visual name="visual"><geometry><cylinder><radius>0.008</radius><length>0.107</length></cylinder></geometry><material><ambient>0.12 0.12 0.12 1</ambient></material></visual></link>
		<joint name="pillar_fr_joint" type="fixed"><parent>lower_plate</parent><child>pillar_fr</child></joint>
		<link name="pillar_rl"><pose>-0.13 0.095 0.1245 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial><visual name="visual"><geometry><cylinder><radius>0.008</radius><length>0.107</length></cylinder></geometry><material><ambient>0.12 0.12 0.12 1</ambient></material></visual></link>
		<joint name="pillar_rl_joint" type="fixed"><parent>lower_plate</parent><child>pillar_rl</child></joint>
		<link name="pillar_rr"><pose>-0.13 -0.095 0.1245 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial><visual name="visual"><geometry><cylinder><radius>0.008</radius><length>0.107</length></cylinder></geometry><material><ambient>0.12 0.12 0.12 1</ambient></material></visual></link>
		<joint name="pillar_rr_joint" type="fixed"><parent>lower_plate</parent><child>pillar_rr</child></joint>

		<!-- ═══ 4 wheels ═══ -->
		<link name="wheel_lf"><pose>0.06 0.1375 0.0323 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial><collision name="collision"><pose>0 0 0 1.57 0 0</pose><geometry><cylinder><radius>0.0323</radius><length>0.025</length></cylinder></geometry></collision><visual name="visual"><pose>0 0 0 1.57 0 0</pose><geometry><cylinder><radius>0.0323</radius><length>0.025</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient></material></visual></link>
		<joint name="wheel_lf_joint" type="revolute"><parent>lower_plate</parent><child>wheel_lf</child><axis><xyz>0 1 0</xyz></axis></joint>
		<link name="wheel_lr"><pose>-0.06 0.1375 0.0323 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial><collision name="collision"><pose>0 0 0 1.57 0 0</pose><geometry><cylinder><radius>0.0323</radius><length>0.025</length></cylinder></geometry></collision><visual name="visual"><pose>0 0 0 1.57 0 0</pose><geometry><cylinder><radius>0.0323</radius><length>0.025</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient></material></visual></link>
		<joint name="wheel_lr_joint" type="revolute"><parent>lower_plate</parent><child>wheel_lr</child><axis><xyz>0 1 0</xyz></axis></joint>
		<link name="wheel_rf"><pose>0.06 -0.1375 0.0323 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial><collision name="collision"><pose>0 0 0 1.57 0 0</pose><geometry><cylinder><radius>0.0323</radius><length>0.025</length></cylinder></geometry></collision><visual name="visual"><pose>0 0 0 1.57 0 0</pose><geometry><cylinder><radius>0.0323</radius><length>0.025</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient></material></visual></link>
		<joint name="wheel_rf_joint" type="revolute"><parent>lower_plate</parent><child>wheel_rf</child><axis><xyz>0 1 0</xyz></axis></joint>
		<link name="wheel_rr"><pose>-0.06 -0.1375 0.0323 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial><collision name="collision"><pose>0 0 0 1.57 0 0</pose><geometry><cylinder><radius>0.0323</radius><length>0.025</length></cylinder></geometry></collision><visual name="visual"><pose>0 0 0 1.57 0 0</pose><geometry><cylinder><radius>0.0323</radius><length>0.025</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient></material></visual></link>
		<joint name="wheel_rr_joint" type="revolute"><parent>lower_plate</parent><child>wheel_rr</child><axis><xyz>0 1 0</xyz></axis></joint>

		<!-- ═══ RPLIDAR A1: 3 pillars + cylinder (h=20mm, r=35mm) ═══ -->
		<link name="laser_frame"><pose>0.1025 0 0.121 0 0 0</pose>
			<inertial><mass>0.1</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial>
			<visual name="visual"><geometry><cylinder><radius>0.035</radius><length>0.02</length></cylinder></geometry><material><ambient>0.1 0.3 0.8 1</ambient></material></visual>
			<sensor type="ray" name="laser"><update_rate>8</update_rate><ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14</min_angle><max_angle>3.14</max_angle></horizontal></scan><range><min>0.15</min><max>12.0</max><resolution>0.001</resolution></range></ray><plugin name="laser_plugin" filename="libgazebo_ros_ray_sensor.so"><ros><remapping>~/out:=/scan</remapping></ros><output_type>sensor_msgs/LaserScan</output_type><frame_name>laser_frame</frame_name></plugin></sensor>
		</link>
		<joint name="laser_frame_joint" type="fixed"><parent>lower_plate</parent><child>laser_frame</child></joint>

		<!-- LiDAR support pillars (3×, 120° apart, height 50mm) -->
		<link name="lidar_pillar_0"><pose>0.1375 0 0.096 0 0 0</pose><inertial><mass>0.01</mass><inertia><ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz></inertia></inertial><visual name="visual"><geometry><cylinder><radius>0.003</radius><length>0.05</length></cylinder></geometry><material><ambient>0.4 0.4 0.4 1</ambient></material></visual></link>
		<joint name="lidar_pillar_0_joint" type="fixed"><parent>lower_plate</parent><child>lidar_pillar_0</child></joint>
		<link name="lidar_pillar_120"><pose>0.085 0.0303 0.096 0 0 0</pose><inertial><mass>0.01</mass><inertia><ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz></inertia></inertial><visual name="visual"><geometry><cylinder><radius>0.003</radius><length>0.05</length></cylinder></geometry><material><ambient>0.4 0.4 0.4 1</ambient></material></visual></link>
		<joint name="lidar_pillar_120_joint" type="fixed"><parent>lower_plate</parent><child>lidar_pillar_120</child></joint>
		<link name="lidar_pillar_240"><pose>0.085 -0.0303 0.096 0 0 0</pose><inertial><mass>0.01</mass><inertia><ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz></inertia></inertial><visual name="visual"><geometry><cylinder><radius>0.003</radius><length>0.05</length></cylinder></geometry><material><ambient>0.4 0.4 0.4 1</ambient></material></visual></link>
		<joint name="lidar_pillar_240_joint" type="fixed"><parent>lower_plate</parent><child>lidar_pillar_240</child></joint>

		<!-- ═══ Astra Pro (red box on upper plate) ═══ -->
		<link name="camera_link"><pose>0.1525 0 0.180 0 0 0</pose>
			<inertial><mass>0.1</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial>
			<visual name="visual"><geometry><box><size>0.04 0.07 0.02</size></box></geometry><material><ambient>0.6 0.15 0.15 1</ambient></material></visual>
		</link>
		<joint name="camera_joint" type="fixed"><parent>upper_plate</parent><child>camera_link</child></joint>

		<!-- ═══ IMU (inside, invisible) ═══ -->
		<link name="imu_link"><pose>0.0325 0 0.178 0 0 0</pose>
			<sensor type="imu" name="imu"><update_rate>200</update_rate><imu><angular_velocity><x><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></x><y><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></y><z><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></z></angular_velocity><linear_acceleration><x><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev></noise></x><y><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev></noise></y><z><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev></noise></z></linear_acceleration></imu><plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so"><ros><remapping>~/out:=/imu</remapping></ros><frame_name>imu_link</frame_name></plugin></sensor>
		</link>
		<joint name="imu_joint" type="fixed"><parent>lower_plate</parent><child>imu_link</child></joint>

		<!-- ═══ Diff drive plugin ═══ -->
		<plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
			<ros><remapping>cmd_vel:=/cmd_vel</remapping><remapping>odom:=/odom</remapping></ros>
			<update_rate>100</update_rate>
			<left_joint>wheel_lr_joint</left_joint>
			<right_joint>wheel_rr_joint</right_joint>
			<wheel_separation>0.275</wheel_separation>
			<wheel_diameter>0.0646</wheel_diameter>
			<max_wheel_torque>20</max_wheel_torque>
			<max_wheel_acceleration>10</max_wheel_acceleration>
			<publish_odom>true</publish_odom>
			<publish_odom_tf>true</publish_odom_tf>
			<publish_wheel_tf>false</publish_wheel_tf>
			<odometry_frame>odom</odometry_frame>
			<robot_base_frame>lower_plate</robot_base_frame>
		</plugin>

	</model>
</sdf>
